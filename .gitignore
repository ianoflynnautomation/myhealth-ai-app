node_modules/
jspm_packages/
.pnpm-store/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
dist/
dist-ssr/
build/
sdist/
wheels/
share/python-wheels/
*.egg-info/
*.egg
.installed.cfg
.Python
__pypackages__/
.pdm-python
.pdm-build/
.pixi/*
!.pixi/config.toml

# Test reports, coverage, and tool caches.
coverage/
cover/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
*.py.cover
*.lcov
nosetests.xml
test-results/
playwright-report/
blob-report/
