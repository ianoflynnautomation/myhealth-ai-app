*$py.class
*.so
cython_debug/

# Virtual environments. env/ is the venv directory name, not a source tree.
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Secrets and local env.
# .env.example and .env.test are templates with no secrets and stay tracked.
.env
.env.*
!.env.example
!.env.test
.envrc
.pypirc
*.pem
*.p12
*.pfx

# Logs.
logs/
*.log
pip-log.txt
pip-delete-this-directory.txt
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Downloaded model weights. Ollama keeps its models outside this repo.
*.gguf
*.safetensors

# Local databases.
*.sqlite3
*.sqlite3-journal

# Operating system files.
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
ehthumbs.db
Desktop.ini

